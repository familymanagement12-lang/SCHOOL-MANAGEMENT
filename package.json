{
  "name": "mccarthy-hill-school-system",
  "version": "1.0.0",
  "private": true,
  "description": "Single-school management system and library for The McCarthy Hill School",
  "scripts": {
    "db:init": "node scripts/init_db.js",
    "db:migrate:class-assessments": "node scripts/migrate_class_assessments.js",
    "db:migrate:curriculum": "node scripts/migrate_curriculum_foundation.js",
    "db:migrate:student-portal": "node scripts/migrate_student_portal.js",
    "db:migrate:student-support": "node scripts/migrate_student_support_fields.js",
    "db:migrate:school-name": "node scripts/migrate_school_name.js",
    "db:migrate:optional-class-year": "node scripts/migrate_optional_class_year_level.js",
    "db:migrate:optional-class-teacher": "node scripts/migrate_optional_class_teacher.js",
    "db:migrate:accountant-rls": "node scripts/migrate_accountant_rls_audit.js",
    "db:migrate:timetable": "node scripts/migrate_timetable.js",
    "admin:seed": "node scripts/seed_admin.js",
    "demo:school": "node scripts/demo_school_seed.js",
    "dev:backend": "npm --prefix backend run dev",
    "start:backend": "npm --prefix backend start",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "check:backend": "node scripts/check_backend.js",
    "test": "node --test backend/src/services/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "pg": "^8.11.2"
  }
}
