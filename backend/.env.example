# Copy to backend/.env and fill in your own values. Never commit backend/.env
PORT=5000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mccarthy_hill_school
# Runtime API login must be non-superuser and have NOBYPASSRLS.
# Locally, set this to a dedicated restricted role; in production configure it in the host's secret environment.
APP_DATABASE_URL=
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
RESEND_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ADMIN_EMAIL=admin@mccarthyhillschool.edu.gh
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_AT_LEAST_12_CHARACTERS
