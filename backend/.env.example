# Copy to backend/.env and fill in your own values. Never commit backend/.env
PORT=5000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Database-changing CLI commands accept only this explicitly named direct URL.
# DATABASE_URL is not used as a fallback by migration or seed scripts.
DATABASE_URL_UNPOOLED=
# Select exactly one approved CLI target. For Neon, use the pinned development target below.
MIGRATION_TARGET=neon-development
MIGRATION_ROLE=neondb_owner
# For local PostgreSQL instead: MIGRATION_TARGET=local and MIGRATION_ROLE=the local schema owner.
# Local mode accepts only loopback host + database mccarthy_hill_school.
NEON_PROJECT_ID=twilight-tooth-59664905
NEON_BRANCH_ID=br-patient-mud-beoldlob
NEON_BRANCH_NAME=assignment-learning-dev-2026-11-26
NEON_ENDPOINT_ID=ep-spring-cloud-beki8ehk
# Runtime API login must be non-superuser and have NOBYPASSRLS.
# Locally, set this to a dedicated restricted role; in production configure it in the host's secret environment.
APP_DATABASE_URL=
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
RESEND_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=1200
AI_REQUEST_TIMEOUT_MS=30000
AI_CONVERSATION_RETENTION_DAYS=30
# Optional private S3-compatible storage for assignment files.
# Assign an IAM role or configure AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY in the host secret store.
LEARNING_FILES_BUCKET=
AWS_REGION=
# Set only for an S3-compatible provider that uses a custom endpoint.
LEARNING_FILES_ENDPOINT=
# Optional server-side encryption algorithm, e.g. AES256 or aws:kms.
LEARNING_FILES_SSE=
# Optional input/output USD per 1M tokens; leave blank to disable cost estimates.
AI_INPUT_COST_PER_MILLION_USD=
AI_OUTPUT_COST_PER_MILLION_USD=
ADMIN_EMAIL=admin@mccarthyhillschool.edu.gh
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_AT_LEAST_12_CHARACTERS
